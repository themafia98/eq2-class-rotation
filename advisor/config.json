{
  "_readme": "Advisor settings. logFile/logsDir 'auto' = auto-detect newest eq2log_*.txt in common EQ2 install dirs; set an absolute path if detection fails (e.g. logsDir to your <EQ2>\\logs folder). Modern EQ2 does NOT log 'You begin casting X' - abilities are detected from 'YOUR <ability> <verb> ...' effect lines (effectPrefix/effectVerbs). Use `npm run advisor:learn` to see ability lines your patterns didn't catch and add missing verbs.",
  "class": "Inquisitor",
  "dataFile": "data/inquisitor.json",
  "logsDir": "auto",
  "logFile": "auto",
  "defaultRole": "raiddps",
  "castPatterns": [
    "You begin casting {spell}.",
    "You begin to perform {spell}.",
    "You begin channeling {spell}."
  ],
  "effectPrefix": "YOUR",
  "effectVerbs": [
    "hits", "heals", "wards", "reduces", "afflicts", "damages", "crushes", "pierces",
    "slashes", "burns", "freezes", "blasts", "smites", "strikes", "multi attacks",
    "flurries", "interrupts", "dispels", "mesmerizes", "stuns", "roots", "snares",
    "staggers", "taunts", "cures", "shields", "regenerates", "relieves", "absorbs",
    "restores", "drains", "steals", "mends"
  ],
  "engine": { "gcd": 1.0, "combatWindow": 8, "queueSize": 3 },
  "eventCap": 400,
  "replayIntervalMs": 350,
  "tickMs": 250,
  "window": { "opacity": 0.92, "corner": "top-right", "width": 300, "height": 250, "margin": 24 },
  "shortcuts": {
    "roleHeal": "Control+Alt+H",
    "roleSolo": "Control+Alt+S",
    "roleGrpDps": "Control+Alt+D",
    "roleRaid": "Control+Alt+R",
    "toggleClickThrough": "Control+Alt+O",
    "toggleShow": "Control+Alt+G",
    "opacityUp": "Control+Alt+Up",
    "opacityDown": "Control+Alt+Down",
    "openSettings": "Control+Alt+E"
  }
}
