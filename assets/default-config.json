{
  "_readme": "Advisor settings. Seeded into %APPDATA%\\eq2-class-rotation\\ on first run (refreshed on version upgrade, old copy saved as .bak). logFile/logsDir 'auto' = auto-detect newest eq2log_*.txt. Modern EQ2 does NOT log 'You begin casting X'; abilities are detected from 'YOUR <ability> <verb> ...' effect lines (effectPrefix/effectVerbs). Missing keys fall back to built-in defaults.",
  "class": "Inquisitor",
  "dataFile": "data/inquisitor.json",
  "logsDir": "auto",
  "logFile": "auto",
  "defaultRole": "solo",
  "autoDetectClass": true,
  "castPatterns": [
    "You begin casting {spell}.",
    "You begin to perform {spell}.",
    "You begin channeling {spell}."
  ],
  "effectPrefix": "YOUR",
  "effectVerbs": [
    "hits", "heals", "wards", "reduces", "afflicts", "damages", "crushes", "pierces",
    "slashes", "burns", "freezes", "blasts", "smites", "strikes", "multi attacks",
    "flurries", "interrupts", "dispels", "mesmerizes", "stuns", "roots", "snares",
    "staggers", "taunts", "cures", "shields", "regenerates", "relieves", "absorbs",
    "restores", "drains", "steals", "mends"
  ],
  "engine": { "gcd": 1, "combatWindow": 8, "queueSize": 3, "refreshLead": 0 },
  "eventCap": 400,
  "replayIntervalMs": 350,
  "tickMs": 250,
  "logRescanMs": 5000,
  "window": { "opacity": 0.92, "corner": "top-right", "width": 300, "height": 260, "margin": 24 },
  "shortcuts": {
    "roleHeal": "Control+Alt+H",
    "roleSolo": "Control+Alt+S",
    "roleGrpDps": "Control+Alt+D",
    "roleRaid": "Control+Alt+R",
    "toggleClickThrough": "Control+Alt+O",
    "toggleShow": "Control+Alt+G",
    "toggleEditor": "Control+Alt+P",
    "opacityUp": "Control+Alt+Up",
    "opacityDown": "Control+Alt+Down",
    "openSettings": "Control+Alt+E"
  }
}
